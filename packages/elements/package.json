{
	"name": "@activekit/elements",
	"version": "0.2.0-alpha.1",
	"description": "ActiveKit as custom elements — works in Angular, Astro, Rails, Laravel, HTMX and plain HTML.",
	"license": "MIT",
	"homepage": "https://activekit.app",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/msgxdevlabs/activekit-js.git",
		"directory": "packages/elements"
	},
	"bugs": "https://github.com/msgxdevlabs/activekit-js/issues",
	"keywords": [
		"activekit",
		"custom-elements",
		"web-components",
		"angular",
		"astro",
		"htmx"
	],
	"sideEffects": [
		"./dist/auto.js"
	],
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./auto": {
			"types": "./dist/auto.d.ts",
			"default": "./dist/auto.js"
		},
		"./package.json": "./package.json"
	},
	"types": "./dist/index.d.ts",
	"module": "./dist/index.js",
	"files": [
		"dist"
	],
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"activekit": {
		"sizeLimit": {
			"dist/index.js": "3 kB"
		}
	},
	"scripts": {
		"build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsdown",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@activekit/js": "workspace:^"
	},
	"devDependencies": {
		"tsdown": "0.22.14",
		"typescript": "5.9.3"
	},
	"engines": {
		"node": ">=20"
	}
}
