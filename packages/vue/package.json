{
	"name": "@activekit/vue",
	"version": "0.1.0",
	"description": "Vue 3 bindings for ActiveKit — plugin, composables and the embeddable progress widget.",
	"license": "MIT",
	"homepage": "https://activekit.app",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/msgxdevlabs/activekit-js.git",
		"directory": "packages/vue"
	},
	"bugs": "https://github.com/msgxdevlabs/activekit-js/issues",
	"keywords": [
		"activekit",
		"vue",
		"nuxt",
		"streaks",
		"referral",
		"widget"
	],
	"sideEffects": false,
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"types": "./dist/index.d.ts",
	"module": "./dist/index.js",
	"files": [
		"dist"
	],
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"activekit": {
		"sizeLimit": {
			"dist/index.js": "4 kB"
		}
	},
	"scripts": {
		"build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsdown",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@activekit/js": "workspace:^"
	},
	"peerDependencies": {
		"vue": "^3.2.0"
	},
	"devDependencies": {
		"tsdown": "0.22.14",
		"typescript": "5.9.3",
		"vue": "3.5.41"
	},
	"engines": {
		"node": ">=20"
	}
}
