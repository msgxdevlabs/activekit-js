{
	"name": "@activekit/svelte",
	"version": "0.0.0",
	"description": "Svelte 5 bindings for ActiveKit — widget component, action and progress store.",
	"license": "MIT",
	"homepage": "https://activekit.app",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/msgxdevlabs/activekit-js.git",
		"directory": "packages/svelte"
	},
	"bugs": "https://github.com/msgxdevlabs/activekit-js/issues",
	"keywords": [
		"activekit",
		"svelte",
		"sveltekit",
		"streaks",
		"referral",
		"widget"
	],
	"sideEffects": false,
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"types": "./dist/index.d.ts",
	"svelte": "./dist/index.js",
	"files": [
		"dist"
	],
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"scripts": {
		"build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && svelte-package",
		"typecheck": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings"
	},
	"dependencies": {
		"@activekit/js": "workspace:^"
	},
	"peerDependencies": {
		"svelte": "^5.0.0"
	},
	"devDependencies": {
		"@sveltejs/package": "2.5.8",
		"svelte": "5.56.8",
		"svelte-check": "4.7.5",
		"typescript": "5.9.3"
	},
	"engines": {
		"node": ">=20"
	}
}
